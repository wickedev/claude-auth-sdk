{
  "name": "claude-auth-sdk-app",
  "version": "1.0.8",
  "private": true,
  "description": "Claude Auth SDK demo app",
  "author": "Claude Auth SDK contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/wickedev/claude-auth-sdk.git"
  },
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsx build.ts",
    "start": "npm run build && npx electron .",
    "typecheck": "tsc --noEmit",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.claude-auth-sdk.app",
    "productName": "Claude Auth SDK",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "index.html",
      "node_modules/@anthropic-ai/claude-code/**/*"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-code/**/*"
    ],
    "mac": {
      "target": [
        { "target": "dmg" }
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] }
      ],
      "category": "Development"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "npmRebuild": false
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.87",
    "@anthropic-ai/claude-code": "2.1.87",
    "@claude-auth-sdk/core": "0.1.0",
    "@claude-auth-sdk/react": "0.1.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.1.6",
    "electron": "35.7.5",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3"
  }
}
