{
  "name": "claude-auth-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Claude auth SDK monorepo",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check packages/ examples/",
    "lint:fix": "biome check --write packages/ examples/",
    "publish:all": "npm run build -w @claude-auth-sdk/core -w @claude-auth-sdk/react && npm publish --access public -w @claude-auth-sdk/core && npm publish --access public -w @claude-auth-sdk/react"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4"
  }
}
